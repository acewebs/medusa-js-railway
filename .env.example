# Overrides for docker-compose.yml. Copy to .env to change any of them; every
# value below is the default the compose file already uses, so an empty .env
# works. See docs/local-testing.md.
#
# This file is NOT how the Railway deployment is configured. That lives in
# .railway/railway.ts and the template composer, see docs/railway-template.md.

# Published host ports. Change one if it collides with another project.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MEDUSA_PORT=9000
MEDIA_PROXY_PORT=9300
# The storefront runs with host networking locally, so its port is fixed at 8000.

# Secrets. Local throwaways; Railway generates real ones per deploy.
JWT_SECRET=local-jwt-secret
COOKIE_SECRET=local-cookie-secret

# First admin account, created on first boot and never reset afterwards.
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=supersecret

# The storefront's publishable key. Set on the backend and referenced by the
# storefront, because Next inlines it at build time and the backend has not run
# yet when that build happens. Bootstrap writes this exact value onto the
# publishable key, so both sides agree from the first deploy onwards.
MEDUSA_PUBLISHABLE_KEY=pk_local_development_key_0000000000000000

# Where things are reachable from a browser.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=dk
# Public base URL for uploaded files, persisted onto every product image.
S3_FILE_URL=http://localhost:9300

# CORS. The storefront and admin origins.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Demo catalogue on first boot. Seeded once, never resurrected after you delete
# the products.
SEED_DEMO_DATA=true
